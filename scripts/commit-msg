#!/bin/sh
# Hook opcional: rechaza commits sin código de tarea (APP-01, APP-02...).
# Instalar:  cp scripts/commit-msg .git/hooks/commit-msg && chmod +x .git/hooks/commit-msg
if ! grep -Eq 'APP-[0-9]{2}' "$1"; then
  echo "x El mensaje del commit debe incluir el código de la tarea (ej. APP-01)." >&2
  exit 1
fi
